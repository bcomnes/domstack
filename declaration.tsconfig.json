{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "exclude": [
    "**/*.test.js",
    "**/*.test.ts",
    "**/*test-helpers.js",
    "**/fixtures/**/*",
    "lib/cli/tests/**/*",
    "lib/watch/*-tests/**/*",
    "type-tests/**/*",
    "test-fixtures/**/*",
    "test-cases/**/*",
    "site/**/*",
  ]
}
